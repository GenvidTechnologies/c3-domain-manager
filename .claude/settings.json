{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/check-dep-floor.mjs\" || true",
            "statusMessage": "Checking dependency floor docs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
